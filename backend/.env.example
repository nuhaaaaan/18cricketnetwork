# 18 Cricket Network — backend environment (example)
# Copy to .env and fill in real values. NEVER commit a real .env.

# MongoDB connection (local dev default shown; use an Atlas SRV URI in prod)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="18cricketnetwork"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"

# AI assistant (optional; chatbot is disabled gracefully if unset)
EMERGENT_LLM_KEY=""
# OPENAI_API_KEY=""

# Razorpay (optional; payments disabled if unset)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
